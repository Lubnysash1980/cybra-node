#!/data/data/com.termux/files/usr/bin/bash
CYBRA_HOME="${HOME}/CYBRA"
NODE_DIR="${CYBRA_HOME}/@cybra"
LOG="${CYBRA_HOME}/logs/evo_node_cybra.log"
mkdir -p "${CYBRA_HOME}/logs"
log() { echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] $1" >> "$LOG"; }

cd "$NODE_DIR" || exit 1
log "=== Node @cybra Start ==="

while true; do
    log "--- Cycle ---"
    
    # 1. Перевірка EVO
    if [ ! -f "index.json" ]; then
        log "EVO: немає index.json, робимо rollback"
        git reset --hard HEAD --quiet 2>/dev/null
        # git clean -fd (вимкнено, щоб не видаляти модулі парламенту)
    fi
    
    # 2. Створюємо снапшот (якщо є hash_eco)
    if [ -x "$CYBRA_HOME/bin/cybra_hash_eco" ]; then
        "$CYBRA_HOME/bin/cybra_hash_eco" snapshot >/dev/null 2>&1
        log "EVO: снапшот створено"
    fi
    
    log "EVO: 100% — нода @cybra стабільна"
    sleep 60

# ─── 7 РІВНІВ СКЛАДНОСТІ ───
LEVEL_FILE="/data/data/com.termux/files/home/CYBRA/state/cybra_autonode_cybra.level"
level_now() { [ -f "$LEVEL_FILE" ] && cat "$LEVEL_FILE" || echo 1; }
level_set() { echo "$1" > "$LEVEL_FILE"; }
level1() { [ -d "$HOME/CYBRA" ] && return 0 || return 1; }
level2() { command -v bash >/dev/null && return 0 || return 1; }
level3() { [ -d "$HOME/CYBRA/modules" ] && return 0 || return 1; }
level4() { [ -d "$HOME/CYBRA/logs" ] && return 0 || return 1; }
level5() { [ -f "$HOME/CYBRA/evo/evo_core.py" ] && return 0 || return 1; }
level6() { [ -d "$HOME/CYBRA/modules" ] && return 0 || return 1; }
level7() { [ -d "$HOME/CYBRA/sandbox" ] && return 0 || return 1; }
run_levels() {
    local cur=$(level_now)
    for i in 1 2 3 4 5 6 7; do
        [ "$i" -lt "$cur" ] && continue
        if "level$i"; then level_set "$i"; else return 0; fi
    done
}
run_levels

done
