#!/data/data/com.termux/files/usr/bin/bash
# cybra-autopatch — автостворення, перевірка, виправлення cybra-core
# 7 рівнів. Через cat/sed. Без ручного втручання.

export HOME="/data/data/com.termux/files/home"
export PATH="/data/data/com.termux/files/usr/bin:$HOME/bin:$HOME/CYBRA/bin:$PATH"
CYBRA="$HOME/CYBRA"
CORE="$CYBRA/bin/cybra-core"
LOG="$CYBRA/logs/autopatch.log"
mkdir -p "$CYBRA/logs" "$CYBRA/state"

log() { echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] $1" >> "$LOG"; }

# --- Рівень 1: створити cybra-core ---
level1_create() {
    cat > "$CORE" <<'CORE_EOF'
#!/data/data/com.termux/files/usr/bin/bash
# cybra-core — ядро CYBRA (автостворено)
export HOME="/data/data/com.termux/files/home"
export PATH="/data/data/com.termux/files/usr/bin:$HOME/bin:$HOME/CYBRA/bin:$PATH"
CYBRA="$HOME/CYBRA"
LOG="$CYBRA/logs/cybra-core.log"
STATE="$CYBRA/state/core.level"
mkdir -p "$CYBRA/logs" "$CYBRA/state"
log() { echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] $1" >> "$LOG"; }
level_now() { [ -f "$STATE" ] && cat "$STATE" || echo 1; }
level_set() { echo "$1" > "$STATE"; log "LEVEL: $1"; }

ad_menu() {
    while true; do
        echo ""
        echo "════ 151. РЕКЛАМА ════"
        echo "1) Створити"
        echo "2) Статус"
        echo "3) Реверс"
        echo "0) Назад"
        read -r -p "Вибір: " c
        case "$c" in
            1) ad_create ;;
            2) ad_status ;;
            3) ad_refund ;;
            0) return ;;
            *) echo "невідомо" ;;
        esac
    done
}
ad_create() {
    echo ""
    read -r -p "Що рекламуємо: " what
    read -r -p "Платформа: " platform
    read -r -p "URL: " url
    if ! echo "$url" | grep -qE '^https?://'; then
        echo "❌ URL невалідний"
        return
    fi
    read -r -p "Обсяг (1-7): " volume
    echo "AI: складність=$volume/7, ціна=$volume*0.01 BNB"
    echo "50% вам, 50% менеджеру"
    log "AD CREATE: $what | $platform | $url | $volume"
    echo "✅ Створено"
}
ad_status() {
    echo ""
    [ -f "$LOG" ] && grep "AD CREATE" "$LOG" | tail -10 || echo "немає записів"
}
ad_refund() {
    echo ""
    echo "Реверс коштів менеджеру"
    log "AD REFUND"
    echo "✅ Ініційовано"
}

rollback_menu() {
    while true; do
        echo ""
        echo "════ 152. ВІДКАТ EVO ════"
        echo "1) Стан"
        echo "2) Відкат"
        echo "0) Назад"
        read -r -p "Вибір: " c
        case "$c" in
            1) rollback_status ;;
            2) rollback_do ;;
            0) return ;;
            *) echo "невідомо" ;;
        esac
    done
}
rollback_status() {
    echo ""
    echo "Рівень: $(level_now)/7"
    [ -d "$CYBRA/.git" ] && echo "Git: $(cd "$CYBRA" && git rev-parse --short HEAD 2>/dev/null)"
    echo "EVO: $([ -f "$CYBRA/evo/evo_core.py" ] && echo 'є' || echo 'немає')"
}
rollback_do() {
    echo ""
    read -r -p "Підтвердити? (yes/no): " ok
    [ "$ok" != "yes" ] && echo "скасовано" && return
    [ -d "$CYBRA/.git" ] && (cd "$CYBRA" && git reset --hard HEAD --quiet 2>/dev/null)
    rm -f "$STATE"
    log "ROLLBACK"
    echo "✅ Відкат виконано"
}

main_menu() {
    while true; do
        echo ""
        echo "════ CYBRA CORE — рівень $(level_now)/7 ════"
        echo "151) Реклама"
        echo "152) Відкат EVO"
        echo "0) Вихід"
        read -r -p "Вибір: " c
        case "$c" in
            151) ad_menu ;;
            152) rollback_menu ;;
            0) exit 0 ;;
            *) echo "невідомо" ;;
        esac
    done
}

case "${1:-menu}" in
    menu) main_menu ;;
    151) ad_menu ;;
    152) rollback_menu ;;
    level) echo "Рівень: $(level_now)/7" ;;
    *) main_menu ;;
esac
CORE_EOF
    chmod +x "$CORE"
    log "L1: cybra-core створено"
}

# --- Рівень 2: перевірити синтаксис ---
level2_check() {
    if bash -n "$CORE" 2>/dev/null; then
        log "L2: синтаксис OK"
        return 0
    else
        log "L2: синтаксис FAIL"
        return 1
    fi
}

# --- Рівень 3: авто-виправлення (якщо треба) ---
level3_fix() {
    if ! bash -n "$CORE" 2>/dev/null; then
        log "L3: спроба виправлення"
        level1_create
        bash -n "$CORE" 2>/dev/null && log "L3: виправлено"
    else
        log "L3: виправлення не потрібне"
    fi
}

# --- Рівень 4: перевірити, що меню працює ---
level4_test() {
    local out
    out=$("$CORE" level 2>/dev/null)
    if echo "$out" | grep -q "Рівень"; then
        log "L4: меню OK ($out)"
    else
        log "L4: меню FAIL"
    fi
}

# --- Рівень 5: health-check ---
level5_health() {
    [ -f "$CYBRA/bin/cybra_autonode_main.js" ] && log "L5: autonode є" || log "L5: немає autonode"
    [ -d "$CYBRA/sandbox" ] && log "L5: sandbox є" || log "L5: немає sandbox"
}

# --- Рівень 6: приєднання до EVO ---
level6_evo() {
    if [ -f "$CYBRA/evo/evo_core.py" ]; then
        log "L6: EVO є"
    else
        log "L6: EVO немає"
    fi
}

# --- Рівень 7: фінал ---
level7_done() {
    log "L7: автопатч завершено. Рівень: $(cat "$CYBRA/state/core.level" 2>/dev/null || echo 1)/7"
    echo "✅ cybra-core готовий: $CORE"
    echo "Запуск: $CORE"
}

# --- головний цикл (7 рівнів) ---
main() {
    log "=== autopatch start ==="
    level1_create
    level2_check || { level3_fix; }
    level4_test
    level5_health
    level6_evo
    level7_done
    log "=== autopatch done ==="
}

case "${1:-run}" in
    run)   main ;;
    level) echo "autopatch: 7/7" ;;
    *)     main ;;

# ─── 7 РІВНІВ СКЛАДНОСТІ ───
LEVEL_FILE="/data/data/com.termux/files/home/CYBRA/state/cybra-autopatch.level"
level_now() { [ -f "$LEVEL_FILE" ] && cat "$LEVEL_FILE" || echo 1; }
level_set() { echo "$1" > "$LEVEL_FILE"; }
level1() { [ -d "$HOME/CYBRA" ] && return 0 || return 1; }
level2() { command -v bash >/dev/null && return 0 || return 1; }
level3() { [ -d "$HOME/CYBRA/modules" ] && return 0 || return 1; }
level4() { [ -d "$HOME/CYBRA/logs" ] && return 0 || return 1; }
level5() { [ -f "$HOME/CYBRA/evo/evo_core.py" ] && return 0 || return 1; }
level6() { [ -d "$HOME/CYBRA/modules" ] && return 0 || return 1; }
level7() { [ -d "$HOME/CYBRA/sandbox" ] && return 0 || return 1; }
run_levels() {
    local cur=$(level_now)
    for i in 1 2 3 4 5 6 7; do
        [ "$i" -lt "$cur" ] && continue
        if "level$i"; then level_set "$i"; else return 0; fi
    done
}
run_levels

esac
