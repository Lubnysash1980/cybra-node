#!/data/data/com.termux/files/usr/bin/bash

ROOT="$HOME/CYBRA"

if [ ! -f "$ROOT/config/cybroncybra.env" ]; then
    echo "[CYBRONCYBRA][FAIL] Domain config missing."
    exit 1
fi

set -a
. "$ROOT/config/cybroncybra.env"
set +a

export DOMAIN
export CYBRA_DOMAIN
export CYBRONCYBRA_DOMAIN

export CYBRA_DOMAIN_URL="https://${DOMAIN}"
export CYBRA_WWW_URL="https://www.${DOMAIN}"
export CYBRA_API_URL="https://api.${DOMAIN}"
export CYBRA_NODE_URL="https://node.${DOMAIN}"

echo "CYBRA_DOMAIN=$CYBRA_DOMAIN"
echo "DOMAIN=$DOMAIN"
echo "CYBRA_DOMAIN_URL=$CYBRA_DOMAIN_URL"
echo "CYBRA_WWW_URL=$CYBRA_WWW_URL"
echo "CYBRA_API_URL=$CYBRA_API_URL"

# ─── 7 РІВНІВ СКЛАДНОСТІ ───
LEVEL_FILE="/data/data/com.termux/files/home/CYBRA/state/cybroncybra-env.level"
level_now() { [ -f "$LEVEL_FILE" ] && cat "$LEVEL_FILE" || echo 1; }
level_set() { echo "$1" > "$LEVEL_FILE"; }
level1() { [ -d "$HOME/CYBRA" ] && return 0 || return 1; }
level2() { command -v bash >/dev/null && return 0 || return 1; }
level3() { [ -d "$HOME/CYBRA/modules" ] && return 0 || return 1; }
level4() { [ -d "$HOME/CYBRA/logs" ] && return 0 || return 1; }
level5() { [ -f "$HOME/CYBRA/evo/evo_core.py" ] && return 0 || return 1; }
level6() { [ -d "$HOME/CYBRA/modules" ] && return 0 || return 1; }
level7() { [ -d "$HOME/CYBRA/sandbox" ] && return 0 || return 1; }
run_levels() {
    local cur=$(level_now)
    for i in 1 2 3 4 5 6 7; do
        [ "$i" -lt "$cur" ] && continue
        if "level$i"; then level_set "$i"; else return 0; fi
    done
}
run_levels

echo "CYBRA_NODE_URL=$CYBRA_NODE_URL"
