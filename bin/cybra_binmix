#!/data/data/com.termux/files/usr/bin/bash
# cybra_binmix v2 — REAL mixer
# Читає pending → пушить у queue шарами → чекає drain → RAM guard → контракт
set -u
CYBRA="$HOME/CYBRA"
BINMIX_DIR="$CYBRA/.binmix"
PID_FILE="$BINMIX_DIR/binmix.pid"
STATE_FILE="$BINMIX_DIR/state.json"
LOG_FILE="$CYBRA/logs/binmix.log"
CONTRACT_DIR="$CYBRA/state/contracts"
mkdir -p "$BINMIX_DIR" "$CONTRACT_DIR" "$(dirname "$LOG_FILE")"

BATCH_SIZE="${BINMIX_BATCH:-2}"
DRAIN_THRESHOLD="${BINMIX_DRAIN:-0}"
RAM_LIMIT="${BINMIX_RAM:-80}"
SLEEP_BETWEEN="${BINMIX_SLEEP:-2}"
STALL_LIMIT="${BINMIX_STALL:-15}"
TARGET="${BINMIX_TARGET:-160}"
PENDING_KEY="${BINMIX_PENDING:-cybra:menu:pending}"
QUEUE_KEY="${BINMIX_QUEUE:-cybra:menu:queue}"
DONE_KEY="${BINMIX_DONE:-cybra:menu:results}"

now(){ date -u +"%Y-%m-%dT%H:%M:%SZ"; }
rd(){ redis-cli "$@" 2>/dev/null; }
log_msg(){ echo "[$(now)] $*" >> "$LOG_FILE"; }
ram_pct(){ free -m 2>/dev/null | awk '/Mem:/{printf "%d",$3/$2*100}'; }
is_running(){ [ -f "$PID_FILE" ] || return 1; local p; p=$(cat "$PID_FILE" 2>/dev/null); [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

write_state(){
  cat > "$STATE_FILE" <<EOF
{
  "ts": "$(now)",
  "pid": $(cat "$PID_FILE" 2>/dev/null || echo 0),
  "layer": $1,
  "pending": $2,
  "queue": $3,
  "done": $4,
  "ram_pct": $(ram_pct),
  "status": "$5"
}
EOF
}

sign_contract(){
  local sh sig
  sh=$( { echo "target=$TARGET"; redis-cli hgetall "$DONE_KEY" 2>/dev/null; } | sha256sum | awk '{print $1}' )
  sig=$(printf '%s%s' "$sh" "$(now)" | sha256sum | awk '{print $1}')
  cat > "$CONTRACT_DIR/bar_menu_${TARGET}.contract.json" <<EOF
{
  "module": "bar_keepers",
  "menu_size": $TARGET,
  "achieved_at": "$(now)",
  "state_hash": "$sh",
  "signature": "$sig",
  "target_key": "$DONE_KEY"
}
EOF
  log_msg "CONTRACT SIGNED → $CONTRACT_DIR/bar_menu_${TARGET}.contract.json"
}

mixer_loop(){
  local layer=0 initial total
  initial=$(rd llen "$PENDING_KEY")
  total=$((initial + $(rd llen "$QUEUE_KEY")))
  log_msg "═══ MIXER START pending=$initial queue=$(rd llen "$QUEUE_KEY") target=$TARGET batch=$BATCH_SIZE ═══"

  local stuck=0 last_q=-1
  while true; do
    local ram pending queue done
    ram=$(ram_pct); pending=$(rd llen "$PENDING_KEY"); queue=$(rd llen "$QUEUE_KEY"); done=$(rd llen "$DONE_KEY")

    if [ "${ram:-0}" -ge "$RAM_LIMIT" ]; then
      log_msg "RAM ${ram}% ≥ ${RAM_LIMIT}% → pause 15s"
      write_state "$layer" "$pending" "$queue" "$done" "ram_pause"
      sleep 15; continue
    fi

    # Фінал: pending і queue порожні + було що міксувати
    if [ "${pending:-0}" -eq 0 ] && [ "${queue:-0}" -eq 0 ]; then
      log_msg "DRAINED after $layer layers | done(hlen)=$done/$TARGET"
      write_state "$layer" 0 0 "$done" "complete"
      sign_contract
      return 0
    fi

    # Чекаємо поки menu-worker розгребе
    if [ "${queue:-0}" -gt "$DRAIN_THRESHOLD" ]; then
      write_state "$layer" "$pending" "$queue" "$done" "draining"
      if [ "$queue" -eq "$last_q" ]; then
        stuck=$((stuck+1))
        if [ "$stuck" -ge "$STALL_LIMIT" ]; then
          log_msg "STALL: queue=$queue unchanged ${stuck} cycles — menu-worker живий? (pm2 status menu-worker)"
          stuck=0
        fi
      else
        stuck=0
      fi
      last_q=$queue
      sleep 2; continue
    fi

    # Пушимо шар
    local pushed=0
    for i in $(seq 1 "$BATCH_SIZE"); do
      local item; item=$(rd lpop "$PENDING_KEY")
      [ -z "$item" ] && break
      rd rpush "$QUEUE_KEY" "$item" >/dev/null
      pushed=$((pushed+1))
    done
    if [ "$pushed" -gt 0 ]; then
      layer=$((layer+1))
      log_msg "LAYER $layer +$pushed | pending=$(rd llen "$PENDING_KEY") queue=$(rd llen "$QUEUE_KEY") done=$done/$TARGET"
    fi
    write_state "$layer" "$(rd llen "$PENDING_KEY")" "$(rd llen "$QUEUE_KEY")" "$done" "mixing"
    sleep "$SLEEP_BETWEEN"
  done
}

cmd_start(){
  is_running && { echo "⚠️  running (pid=$(cat "$PID_FILE"))"; return 0; }
  echo "▶ binmix REAL mixer…"
  setsid bash -c "$(declare -f now rd log_msg ram_pct write_state sign_contract mixer_loop);
    CYBRA='$CYBRA'; BINMIX_DIR='$BINMIX_DIR'; STATE_FILE='$STATE_FILE'; LOG_FILE='$LOG_FILE';
    CONTRACT_DIR='$CONTRACT_DIR'; BATCH_SIZE='$BATCH_SIZE'; DRAIN_THRESHOLD='$DRAIN_THRESHOLD';
    RAM_LIMIT='$RAM_LIMIT'; SLEEP_BETWEEN='$SLEEP_BETWEEN'; STALL_LIMIT='$STALL_LIMIT';
    TARGET='$TARGET'; PENDING_KEY='$PENDING_KEY'; QUEUE_KEY='$QUEUE_KEY'; DONE_KEY='$DONE_KEY';
    PID_FILE='$PID_FILE'; mixer_loop" >/dev/null 2>&1 &
  echo $! > "$PID_FILE"
  sleep 1
  log_msg "daemon pid=$(cat "$PID_FILE")"
  echo "✅ pid=$(cat "$PID_FILE")  batch=$BATCH_SIZE target=$TARGET"
  echo "   pending=$PENDING_KEY  queue=$QUEUE_KEY  done=$DONE_KEY"
}

cmd_stop(){ is_running && { kill "$(cat "$PID_FILE")" 2>/dev/null; rm -f "$PID_FILE"; log_msg stopped; echo "⏹"; } || echo "ℹ️  not running"; }
cmd_status(){
  echo "═══ BINMIX v2 ═══"
  is_running && echo "  🟢 RUNNING pid=$(cat "$PID_FILE")" || echo "  🔴 STOPPED"
  echo "  pending: $(rd llen "$PENDING_KEY")"
  echo "  queue:   $(rd llen "$QUEUE_KEY")"
  echo "  done:    $(rd llen "$DONE_KEY")/$TARGET"
  echo "  RAM:     $(ram_pct)%"
  [ -f "$STATE_FILE" ] && { echo "  ─── state ───"; cat "$STATE_FILE"; }
}
case "${1:-status}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; sleep 1; cmd_start ;;
  status) cmd_status ;;
  log) tail -40 "$LOG_FILE" ;;
  *) echo "usage: $0 {start|stop|restart|status|log}"; exit 1 ;;
esac
