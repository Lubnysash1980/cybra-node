#!/data/data/com.termux/files/usr/bin/bash
export HOME="/data/data/com.termux/files/home"
export PATH="/data/data/com.termux/files/usr/bin:$HOME/bin:$HOME/CYBRA/bin:$PATH"
CYBRA="$HOME/CYBRA"
DB="$CYBRA/data/ads.db"
mkdir -p "$CYBRA/data" "$CYBRA/logs"

sqlite3 "$DB" "CREATE TABLE IF NOT EXISTS ads (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  what TEXT, platform TEXT, url TEXT,
  volume INTEGER, price_bnb REAL,
  status TEXT DEFAULT 'created',
  created_at TEXT
);"

ad_create() {
    local what platform url volume
    if [ $# -ge 4 ]; then
        what="$1"; platform="$2"; url="$3"; volume="$4"
    else
        echo ""
        read -r -p "Що рекламуємо: " what
        read -r -p "Платформа (TikTok/FB/сайт): " platform
        read -r -p "URL: " url
        read -r -p "Обсяг (1-7): " volume
    fi

    # валідація
    [ -z "$what" ] && { echo "❌ Що рекламуємо — порожньо"; return 1; }
    [ -z "$platform" ] && { echo "❌ Платформа — порожньо"; return 1; }
    echo "$url" | grep -qE '^https?://' || { echo "❌ URL невалідний: '$url'"; return 1; }
    echo "$volume" | grep -qE '^[1-7]$' || { echo "❌ Обсяг має бути 1-7, а не '$volume'"; return 1; }

    local price=$(echo "scale=4; $volume * 0.01" | bc 2>/dev/null || echo "0.01")
    local now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local id=$(sqlite3 "$DB" "INSERT INTO ads (what,platform,url,volume,price_bnb,created_at) VALUES ('$what','$platform','$url',$volume,$price,'$now'); SELECT last_insert_rowid();")
    echo "✅ Реклама #$id | $price BNB | 50/50"
}

ad_status() {
    echo ""
    sqlite3 -header -column "$DB" "SELECT id,what,platform,volume,price_bnb,status FROM ads ORDER BY id DESC LIMIT 10;"
}

ad_refund() {
    echo ""
    read -r -p "ID для реверсу: " id
    local n=$(sqlite3 "$DB" "SELECT COUNT(*) FROM ads WHERE id=$id;")
    [ "$n" = "0" ] && { echo "❌ #$id не знайдено"; return; }
    sqlite3 "$DB" "UPDATE ads SET status='refunded' WHERE id=$id;"
    echo "✅ #$id → refunded"
}

case "$1" in
    create) shift; ad_create "$@" ;;
    status) ad_status ;;
    refund) ad_refund ;;
    menu)
        while true; do
            echo ""
            echo "════ 151. РЕКЛАМА ════"
            echo "1) Створити  2) Статус  3) Реверс  0) Назад"
            read -r -p "Вибір: " c
            case "$c" in
                1) ad_create ;;
                2) ad_status ;;
                3) ad_refund ;;
                0) exit 0 ;;
                *) echo "невідомо" ;;
            esac
        done
        ;;
    *) echo "usage: $0 [create|status|refund|menu]" ;;
esac
