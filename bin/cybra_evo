#!/data/data/com.termux/files/usr/bin/bash
source "$HOME/CYBRA/modules/module_20_evolution_guard/bin/cybra_evolution.sh"

case "${1:-check}" in
    check)
        echo "=== EVOLUTION GUARD — CHECK ==="
        evo_check_all
        ;;
    snapshot)
        evo_snapshot
        ;;
    approve)
        evo_approve "$2"
        ;;
    reject)
        evo_reject "$2" "$3"
        ;;
    freeze)
        evo_freeze
        ;;
    unfreeze)
        evo_unfreeze
        ;;
    frozen)
        if evo_is_frozen; then
            echo "FROZEN"
        else
            echo "OK"
        fi
        ;;
    ledger)
        cat "$HOME/CYBRA/evolution/evolution_ledger.txt" 2>/dev/null || echo "(empty)"
        ;;
    blocked)
        cat "$HOME/CYBRA/evolution/blocked.log" 2>/dev/null || echo "(empty)"
        ;;
    *)
        echo "Usage: cybra_evo {check|snapshot|approve <mod>|reject <mod>|freeze|unfreeze|frozen|ledger|blocked}"
        ;;

# ─── 7 РІВНІВ СКЛАДНОСТІ ───
LEVEL_FILE="/data/data/com.termux/files/home/CYBRA/state/cybra_evo.level"
level_now() { [ -f "$LEVEL_FILE" ] && cat "$LEVEL_FILE" || echo 1; }
level_set() { echo "$1" > "$LEVEL_FILE"; }
level1() { [ -d "$HOME/CYBRA" ] && return 0 || return 1; }
level2() { command -v bash >/dev/null && return 0 || return 1; }
level3() { [ -d "$HOME/CYBRA/modules" ] && return 0 || return 1; }
level4() { [ -d "$HOME/CYBRA/logs" ] && return 0 || return 1; }
level5() { [ -f "$HOME/CYBRA/evo/evo_core.py" ] && return 0 || return 1; }
level6() { [ -d "$HOME/CYBRA/modules" ] && return 0 || return 1; }
level7() { [ -d "$HOME/CYBRA/sandbox" ] && return 0 || return 1; }
run_levels() {
    local cur=$(level_now)
    for i in 1 2 3 4 5 6 7; do
        [ "$i" -lt "$cur" ] && continue
        if "level$i"; then level_set "$i"; else return 0; fi
    done
}
run_levels

esac
