MODULE_ID=20
MODULE_NAME=CYBRA_EVOLUTION_GUARD
MODULE_VERSION=1.0.0
PATCH_ID=CYBRA-M20-PATCH-0001

MODE=TEST
POLICY=STRICT_NON_DEGRADATION

# 3% tolerance — більше не можна
TOLERANCE_PERCENT=3
TOLERANCE_NUM=3

# Політика
ALLOW_IMPROVEMENT=TRUE
ALLOW_EQUAL=TRUE
ALLOW_3PCT_DEVIATION=TRUE
ALLOW_MAJOR_DEGRADATION=FALSE

# Дозволи
REQUIRE_OWNER_FOR_EVOLUTION=TRUE
REQUIRE_HASH_MATCH=TRUE
REQUIRE_BASELINE_MATCH=TRUE
FREEZE_ON_DEGRADATION=TRUE
ALERT_ON_EVOLUTION=TRUE

# Заборона
ALLOW_MODULE_DELETION=FALSE
ALLOW_RULE_DELETION=FALSE
ALLOW_RECIPIENT_CHANGE=FALSE
ALLOW_LICENSE_REDUCTION=FALSE
ALLOW_SECURITY_REDUCTION=FALSE

# Owner
OWNER_MARKER=$HOME/CYBRA/.owner

GLOBAL_TRUE_100=FALSE
AUTO_TRANSACTION=FALSE
REAL_TRANSACTION_SENT=FALSE
