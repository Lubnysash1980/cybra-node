{
  "id": "parliament",
  "name": "Parliament",
  "version": "0.2.0",
  "description": "Goal-directed decision layer with veto, weighted vote, sanity-check and auto-propose daemon.",
  "depends": [
    "stakeawtodump"
  ],
  "state_dir": "state",
  "entrypoints": {
    "install": "bin/install.sh",
    "ctl": "bin/parliament_ctl.sh",
    "propose": "bin/parliament.sh propose",
    "decide": "bin/parliament.sh decide",
    "status": "bin/parliament.sh status"
  }
}
