{
  "id": "stakeawtodump",
  "name": "StakeAutoDump",
  "version": "1.0.0",
  "category": "system",
  "license": "MIT",
  "author": "CYBRA",
  "description": "Fully-automatic dump stack: bg_dump + autowatch + autogit + autoheal + auto-resurrect.",
  "components": [
    "dump",
    "autowatch",
    "autogit",
    "autoheal"
  ],
  "entrypoints": {
    "install": "bin/install.sh",
    "start": "bin/start.sh",
    "stop": "bin/stop.sh",
    "status": "bin/status.sh",
    "dump": "bin/dump.sh",
    "restore": "bin/restore.sh"
  },
  "state_dir": "state",
  "requires": [
    "pm2",
    "jq",
    "bash"
  ],
  "provides": {
    "pm2_names": [
      "cybra-bg-dump",
      "cybra-autowatch",
      "cybra-autogit"
    ],
    "redis_keys": [
      "stakeawtodump:status",
      "stakeawtodump:last_dump"
    ],
    "state_files": [
      "state/status.json",
      "state/install.json"
    ]
  }
}
