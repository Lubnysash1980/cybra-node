{
  "god": {
    "purpose": "PM2 process manager",
    "weight": 5,
    "health": "[ $(pgrep -f 'PM2.*God Daemon' | wc -l) -ge 1 ]",
    "escalation": [
      {"attempt": 1, "actions": ["pm2 resurrect"]},
      {"attempt": 2, "actions": ["pm2 resurrect", "pm2 save --force"]}
    ],
    "max_attempts": 2, "cooldown_sec": 300
  },
  "autowatch": {
    "purpose": "supervisor: bg_dump + autogit + autoheal",
    "weight": 3,
    "health": "[ -f $CYBRA/.cache/autowatch.pid ] && kill -0 $(cat $CYBRA/.cache/autowatch.pid 2>/dev/null) 2>/dev/null",
    "escalation": [
      {"attempt": 1, "actions": ["$CYBRA/bin/cybra_autowatch_ctl.sh start"]},
      {"attempt": 2, "actions": ["rm -f $CYBRA/.cache/autowatch.pid", "$CYBRA/bin/cybra_autowatch_ctl.sh start"]}
    ],
    "max_attempts": 2, "cooldown_sec": 600
  },
  "bg_dump": {
    "purpose": "snapshot components 60s + global 900s",
    "weight": 2,
    "health": "[ -f $CYBRA/.cache/bg_dump.pid ] && kill -0 $(cat $CYBRA/.cache/bg_dump.pid 2>/dev/null) 2>/dev/null",
    "escalation": [
      {"attempt": 1, "actions": ["$CYBRA/bin/cybra_bg_dump_ctl.sh start"]},
      {"attempt": 2, "actions": ["rm -f $CYBRA/.cache/bg_dump.pid", "$CYBRA/bin/cybra_bg_dump_ctl.sh start"]}
    ],
    "max_attempts": 2, "cooldown_sec": 600
  },
  "autogit": {
    "purpose": "auto-commit+push every 5min",
    "weight": 2,
    "health": "pm2 jlist 2>/dev/null | jq -r '.[] | select(.name==\"cybra-autogit\") | .pm2_env.status' | grep -qx online",
    "escalation": [
      {"attempt": 1, "actions": ["pm2 restart cybra-autogit"]},
      {"attempt": 2, "actions": ["pm2 delete cybra-autogit || true", "pm2 start $CYBRA/bin/wrappers/run_autogit.sh --name cybra-autogit --interpreter bash --max-memory-restart 65M", "pm2 save --force"]}
    ],
    "max_attempts": 2, "cooldown_sec": 900
  },

  "_business": {
    "purpose": "Бізнес-контракти таксі-сервісу (Redis-based)",
    "redis_prefix": "cybra:taxi:",
    "modules_count": 260
  },
  "taxi_core": {
    "purpose": "Ядро таксі: book_ride, cancel, status, history, estimate",
    "modules": ["module_200_book_ride","module_201_cancel_ride","module_202_ride_status","module_203_ride_history","module_204_estimate_price"],
    "health": "redis-cli ping 2>/dev/null | grep -qx PONG",
    "escalation": [
      {"attempt": 1, "actions": ["pm2 restart taxi-events"]},
      {"attempt": 2, "actions": ["pm2 start $CYBRA/modules/module_200_book_ride/bin/cybra_book_ride.sh --name taxi-book-ride --interpreter bash --max-memory-restart 65M"]}
    ],
    "max_attempts": 2, "cooldown_sec": 600
  },
  "taxi_driver": {
    "purpose": "Водії: register, status, accept, complete, earnings, docs, rating",
    "modules": ["module_210_driver_register","module_211_driver_status","module_212_accept_ride","module_213_complete_ride","module_214_driver_earnings"],
    "health": "redis-cli hlen cybra:taxi:driver:data 2>/dev/null | grep -qE '^[0-9]+$'",
    "escalation": [
      {"attempt": 1, "actions": ["redis-cli hset cybra:taxi:driver:data __health $(date +%s) >/dev/null"]}
    ],
    "max_attempts": 1, "cooldown_sec": 300
  },
  "taxi_dispatch": {
    "purpose": "Диспетчеризація: nearest, batch, surge pricing",
    "modules": ["module_217_dispatch_nearest","module_218_dispatch_batch","module_219_surge_pricing"],
    "health": "pm2 jlist 2>/dev/null | jq -e '.[]|select(.name==\"cybra-ai-dispatcher\")|select(.pm2_env.status==\"online\")' >/dev/null",
    "escalation": [
      {"attempt": 1, "actions": ["pm2 restart cybra-ai-dispatcher || true"]},
      {"attempt": 2, "actions": ["pm2 start $CYBRA/modules/module_230_ai_dispatcher/main.sh --name cybra-ai-dispatcher --interpreter bash --max-memory-restart 65M"]}
    ],
    "max_attempts": 2, "cooldown_sec": 600
  },
  "taxi_payment": {
    "purpose": "Платежі: payment, receipt, refund, escrow, payout, tip",
    "modules": ["module_220_ride_payment","module_221_ride_receipt","module_222_ride_refund","module_223_escrow_ride","module_224_driver_payout"],
    "health": "redis-cli ping 2>/dev/null | grep -qx PONG",
    "escalation": [
      {"attempt": 1, "actions": ["redis-cli hset cybra:taxi:payment:health $(date +%s) ok >/dev/null"]}
    ],
    "max_attempts": 1, "cooldown_sec": 300
  },
  "taxi_wallet": {
    "purpose": "Гаманець: connect, list, balance, topup, history",
    "modules": ["module_246_payment_instant","module_249_wallet_connect","module_250_wallet_list","module_251_wallet_balance","module_227_wallet_topup"],
    "health": "redis-cli ping 2>/dev/null | grep -qx PONG",
    "escalation": [
      {"attempt": 1, "actions": ["redis-cli hset cybra:taxi:wallet:health $(date +%s) ok >/dev/null"]}
    ],
    "max_attempts": 1, "cooldown_sec": 300
  },
  "taxi_ai": {
    "purpose": "AI: dispatcher, chat, route_optimize, forecast, scoring, dispute",
    "modules": ["module_230_ai_dispatcher","module_231_ai_chat_support","module_232_ai_route_optimize","module_233_ai_demand_forecast","module_234_ai_driver_scoring"],
    "health": "pm2 jlist 2>/dev/null | jq -e '.[]|select(.name==\"mock-ai\")|select(.pm2_env.status==\"online\")' >/dev/null || pm2 jlist 2>/dev/null | jq -e '.[]|select(.name==\"cybra-brain\")|select(.pm2_env.status==\"online\")' >/dev/null",
    "escalation": [
      {"attempt": 1, "actions": ["pm2 restart cybra-brain || true"]},
      {"attempt": 2, "actions": ["pm2 restart mock-ai || true"]}
    ],
    "max_attempts": 2, "cooldown_sec": 600
  },
  "taxi_analytics": {
    "purpose": "Аналітика: rider, driver, fleet, metrics",
    "modules": ["module_236_rider_analytics","module_237_driver_analytics","module_238_fleet_analytics","module_239_taxi_metrics"],
    "health": "redis-cli ping 2>/dev/null | grep -qx PONG",
    "escalation": [
      {"attempt": 1, "actions": ["redis-cli hset cybra:taxi:analytics:health $(date +%s) ok >/dev/null"]}
    ],
    "max_attempts": 1, "cooldown_sec": 600
  }
}
