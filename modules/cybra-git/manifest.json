{
  "id": "cybra-git",
  "name": "CYBRA Git",
  "version": "1.0.0",
  "category": "system",
  "license": "MIT",
  "author": "CYBRA / Lubnysash1980",
  "description": "Git integration: auto-commit, doctor, untrack secrets, push/pull sync.",
  "entrypoints": {
    "install": "bin/install.sh",
    "start": "bin/start.sh",
    "stop": "bin/stop.sh",
    "status": "bin/status.sh",
    "doctor": "bin/doctor.sh",
    "commit": "bin/commit.sh",
    "push": "bin/push.sh",
    "sync": "bin/sync.sh",
    "untrack": "bin/untrack.sh"
  },
  "requires": [
    "git",
    "jq",
    "bash"
  ],
  "provides": {
    "pm2_names": [
      "cybra-autogit"
    ],
    "redis_keys": [
      "cybra-git:status",
      "cybra-git:color",
      "cybra-git:last_commit"
    ],
    "state_files": [
      "state/status.json"
    ]
  }
}