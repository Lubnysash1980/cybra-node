MODULE_ID=35
MODULE_NAME=CYBRA_GUARDIAN
MODULE_DESCRIPTION=Guardian of 100% state, auto-recovery, identity vault
MODULE_VERSION=1.0.0
PATCH_ID=CYBRA-M35-PATCH-0001

MODE=TEST
CHAIN_ID=56
NETWORK=BSC_MAINNET

# ─── Guardian ───
GUARDIAN_ENABLED=TRUE
AUTO_RECOVERY_ENABLED=TRUE
AUTO_PUSH_ENABLED=TRUE
HEALTH_CHECK_INTERVAL=300

# ─── Identity ───
IDENTITY_ENABLED=TRUE
BIOMETRIC_ENABLED=TRUE
DEVICE_FINGERPRINT_ENABLED=TRUE
ID_HASH_ALGORITHM=sha256
IDENTITY_SALT=CYBRA_GUARDIAN_v1

# ─── Recovery ───
RECOVERY_FROM_GIT=TRUE
RECOVERY_FROM_BACKUP=TRUE
RECOVERY_AUTO_ON_FAILURE=TRUE
RECOVERY_MAX_ATTEMPTS=3

# ─── Web ───
WEB_SYNC_ENABLED=FALSE
WEB_SYNC_URL=
WEB_SYNC_TOKEN=

# ─── Security ───
REQUIRE_IDENTITY_FOR_CONTRACT=TRUE
REQUIRE_DEVICE_CHECK=TRUE
REQUIRE_BIOMETRIC_HASH=TRUE
LOG_ALL_ACTIONS=TRUE
