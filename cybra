#!/data/data/com.termux/files/usr/bin/bash
# CYBRA — головний launcher.
# Без аргументів (або з невідомим) → TUI-меню (як раніше).
# З відомою підкомандою → виконує її.

CYBRA="$HOME/CYBRA"; cd "$CYBRA" 2>/dev/null || exit 1

# ─── кольори ───
B="\033[1m"; G="\033[32m"; Y="\033[33m"; R="\033[31m"; C="\033[36m"; N="\033[0m"
ok(){ echo -e "${G}✅${N} $*"; }
err(){ echo -e "${R}❌${N} $*"; }
hdr(){ echo -e "\n${B}${C}═══ $* ═══${N}"; }
R(){ redis-cli "$@" 2>/dev/null; }
alive(){ pm2 describe "$1" 2>/dev/null | grep -q 'status.*online'; }

cmd_status(){
  hdr "STATUS"
  if [ -f bin/cybra_state_100.sh ]; then
    bash bin/cybra_state_100.sh 2>&1 | grep -E 'total:|module|pm2|dart|api|READY|→' | sed 's/^/  /'
  fi
  echo
  echo "  redis:      $(R ping 2>/dev/null || echo DOWN)"
  echo "  parliament: $(alive parliament && echo online || echo DOWN)"
  echo "  queue:      $(R llen cybra:parliament:queue 2>/dev/null || echo '?')"
  echo "  results:    $(R llen cybra:parliament:results 2>/dev/null || echo '?')"
  echo "  failed:     $(R llen cybra:parliament:failed 2>/dev/null || echo '?')"
  echo "  RAM:        $(free -m 2>/dev/null | awk '/Mem:/{printf "%d%%",$3/$2*100}')"
  echo
  echo "  ── programs ──"
  for p in a b; do
    if [ -f "programs/prog_$p/main.sh" ]; then
      echo "  prog_$p: $(wc -c < programs/prog_$p/main.sh) bytes"
    else
      echo "  prog_$p: (не згенеровано)"
    fi
  done
  echo "  ── git branches ──"
  git ls-remote --heads origin 'refs/heads/prog/*' 2>/dev/null | awk '{print "  " $2}' || echo "  (none)"
}

cmd_parliament(){
  hdr "PARLIAMENT"
  echo "  queue:   $(R llen cybra:parliament:queue)"
  echo "  results: $(R llen cybra:parliament:results)"
  echo "  failed:  $(R llen cybra:parliament:failed)"
  echo
  echo "  останні 3 results:"
  R lrange cybra:parliament:results 0 2 2>/dev/null | head -3 | python3 -c '
import sys, json
for line in sys.stdin:
    s = line.strip().rstrip(",").strip()
    if not s: continue
    try:
        d = json.loads(s)
        print("    " + str(d.get("topic","?")) + ": " + str(d.get("status","?")))
    except Exception:
        pass
'
}

cmd_test(){
  hdr "TEST PIPELINE"
  local p="${1:-a}"
  echo "  генерую prog_$p через парламент..."
  python3 scripts/ai-writer.py "$p"
}

cmd_sync(){
  hdr "SYNC"
  local p="${1:-all}"
  if [ "$p" = "all" ]; then
    ./scripts/prog-sync.sh a
    ./scripts/prog-sync.sh b
  else
    ./scripts/prog-sync.sh "$p"
  fi
  echo
  echo "  git branches:"
  git ls-remote --heads origin 'refs/heads/prog/*' 2>/dev/null | awk '{print "  " $2}'
}

cmd_start(){
  hdr "START ALL"
  R ping 2>/dev/null | grep -q PONG || { pm2 start redis-server --name redis -- --daemonize no >/dev/null; sleep 2; }
  pm2 resurrect >/dev/null 2>&1
  pm2 start ecosystem.config.js >/dev/null 2>&1
  pm2 save >/dev/null 2>&1
  ok "PM2 online: $(pm2 jlist 2>/dev/null | python3 -c 'import sys,json;print(sum(1 for p in json.load(sys.stdin) if p["pm2_env"]["status"]=="online"))' 2>/dev/null || echo '?')"
}

cmd_stop(){
  hdr "STOP ALL"
  pm2 stop all
  ok "всі зупинено"
}

cmd_logs(){
  local p="${1:-parliament}"
  pm2 logs "$p" --lines 30 --nostream
}

cmd_help(){
  printf '%b' "${B}${C}CYBRA${N} — Cyber Parliament CLI\n\n"
  printf '%b' "${B}Використання:${N}\n"
  printf '%b\n' \
    "  cybra                    → TUI меню 160 (як раніше)" \
    "  cybra help               → ця довідка" \
    "  cybra status             → 100% state, programs, pm2, git branches" \
    "  cybra parliament         → черга парламенту + останні 3 results" \
    "  cybra test [a|b]         → згенерувати програму через парламент" \
    "  cybra sync [a|b|all]     → запушити в prog/a, prog/b, або обидві" \
    "  cybra logs [name]        → pm2 logs <name> (default: parliament)" \
    "  cybra start              → підняти все (redis + pm2)" \
    "  cybra stop               → pm2 stop all" \
    "  cybra pm2                → pm2 list"
  echo
  printf '%b' "${B}Pipeline:${N}\n"
  printf '%b\n' \
    "  ai-writer.py → cybra:parliament:queue → program_writer_task_handler.sh" \
    "                → binmix_base.sh → programs/prog_X/main.sh" \
    "                → prog-sync.sh → GitHub (refs/heads/prog/X)"
}

cmd_restore(){
  hdr "RESTORE 160 MODULES (через парламент)"
  local task='{"topic":"restore_'$(date +%s)'","type":"restore_modules_task","start":1,"end":160}'
  printf '%s' "$task" | redis-cli -x rpush cybra:parliament:queue >/dev/null
  echo "  → подано в парламент, чекаю..."
  local deadline=$(( $(date +%s) + 180 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    sleep 3
    local res=$(R lrange cybra:parliament:results 0 20 | python3 -c "
import sys,json
for line in sys.stdin:
    try:
        d=json.loads(line.strip().rstrip(','))
        if d.get('type')=='restore_modules_task':
            print(d.get('status','?'), d.get('execution',{}).get('stdout','')[:200])
    except: pass
" | head -1)
    if [ -n "$res" ]; then
      echo "  ✅ $res"
      break
    fi
  done
  echo
  local c160=0
  for d in modules/module_*; do
    local n=$(basename "$d" | sed -E 's/^module_0*([0-9]+)_.*/\1/')
    [ -n "$n" ] && [ "$n" -ge 1 ] && [ "$n" -le 160 ] 2>/dev/null && c160=$((c160+1))
  done
  echo "  модулів 1-160: $c160"
  echo "  модулів всього: $(ls -d modules/module_*/ 2>/dev/null | wc -l)"
}

cmd_payment(){
  hdr "PAYMENT SYSTEM"
  local main="modules/module_280_payment_system/main.sh"
  if [ ! -f "$main" ]; then
    echo "  → генерую module_280 через парламент..."
    local task='{"topic":"pay_init_'$(date +%s)'","type":"payment_system_task"}'
    printf '%s' "$task" | redis-cli -x rpush cybra:parliament:queue >/dev/null
    local deadline=$(( $(date +%s) + 30 ))
    while [ "$(date +%s)" -lt "$deadline" ] && [ ! -f "$main" ]; do sleep 2; done
  fi
  [ ! -f "$main" ] && { err "module_280 не створено (30s timeout)"; return 1; }
  bash "$main" "$@"
}

cmd_token(){
  hdr "TOKEN"
  bash modules/module_281_token_system/main.sh "$@"
}

cmd_nfc(){
  hdr "NFC"
  bash modules/module_282_nfc_payment/main.sh "$@"
}

cmd_fix(){
  hdr "ТОЧКА ФІКСАЦІЇ"
  local cp=$(redis-cli get cybra:token:checkpoint 2>/dev/null)
  if [ -z "$cp" ]; then
    warn "checkpoint НЕ встановлено — запускаю guard"
    printf '%s' '{"topic":"guard_'$(date +%s)'","type":"token_nfc_guard_task"}'       | redis-cli -x rpush cybra:parliament:queue >/dev/null
    sleep 5
    cp=$(redis-cli get cybra:token:checkpoint 2>/dev/null)
  fi
  if [ -n "$cp" ]; then
    printf '%s' "$cp" | python3 -m json.tool 2>/dev/null | sed 's/^/  /'
    ok "точка зафіксована"
  else
    err "checkpoint не встановлено"
    local is=$(redis-cli get cybra:token:issues 2>/dev/null)
    [ -n "$is" ] && printf '%s' "$is" | python3 -m json.tool 2>/dev/null | sed 's/^/  /'
    return 1
  fi
}

cmd_guard(){
  hdr "GUARD (ручна перевірка)"
  printf '%s' '{"topic":"guard_'$(date +%s)'","type":"token_nfc_guard_task"}'     | redis-cli -x rpush cybra:parliament:queue >/dev/null
  sleep 5
  local r=$(redis-cli lrange cybra:parliament:results 0 0)
  printf '%s' "$r" | python3 -c "
import sys,json
try:
    d=json.loads(sys.stdin.read().strip().strip(chr(34)))
    ex=d.get('execution',{})
    print('  status:', d.get('status'))
    print('  output:', ex.get('stdout','').strip() or ex.get('stderr','').strip())
except Exception as e:
    print('  raw:', sys.stdin.read()[:300])
"
}

cmd_private(){
  hdr "PRIVACY"
  bash bin/cybra_private.sh "$@"
}

# ─── dispatch ───
case "${1:-__menu__}" in
  __menu__)       exec "$HOME/CYBRA/modules/module_19_contract_tui_menu/bin/cybra_menu.sh" "$@" ;;
  status|st)      cmd_status ;;
  restore|r)      cmd_restore ;;
  payment|pay)    shift; cmd_payment "$@" ;;
  token|tok)      shift; cmd_token "$@" ;;
  fix|f)          cmd_fix ;;
  private|priv)   shift; cmd_private "$@" ;;
  guard|g)        cmd_guard ;;
  nfc)            shift; cmd_nfc "$@" ;;
  parliament|p)   cmd_parliament ;;
  test|t)         shift; cmd_test "$@" ;;
  sync|s)         shift; cmd_sync "$@" ;;
  logs|l)         shift; cmd_logs "$@" ;;
  pm2)            pm2 list ;;
  start|up)       cmd_start ;;
  stop|down)      cmd_stop ;;
  help|-h|--help) cmd_help ;;
  *)              exec "$HOME/CYBRA/modules/module_19_contract_tui_menu/bin/cybra_menu.sh" "$@" ;;
esac
