{
  "hidl_version": "1.0",
  "description": "CYBRA HIDL — Hardware-Independent Dispatch Layer. Уніфікований протокол між меню, контролерами, воркером, екзекутором, парламентом.",
  "message": {
    "id": "string (unique, e.g. HIDL-NNN-EPOCH)",
    "hidl_version": "1.0",
    "action": "execute | verify | restore | notify | score",
    "module": "int 1..160",
    "spec": {
      "name": "string",
      "category": "string",
      "cli": "path|null",
      "default_action": "string"
    },
    "args": "list of strings (default [])",
    "ctrl": "path to ctrl_NNN.sh",
    "main": "path to main.sh",
    "evo": {
      "check": "bool",
      "baseline_file": "state/evo_baseline.json",
      "threshold_pct": 3.0,
      "on_rollback": "restore_from_git | stop | notify_only"
    },
    "git": {
      "access": "bool",
      "repo": "~/CYBRA",
      "branch": "main",
      "on_error": "restore | skip"
    },
    "notify": {
      "targets": ["parliament", "log", "file", "executor_stats"],
      "queue": "cybra:parliament:queue",
      "log": "logs/hidl.log",
      "file": "state/hidl/events.jsonl"
    },
    "callback": {
      "on_success": "queue_name",
      "on_failure": "queue_name",
      "timeout_sec": 30
    }
  },
  "response": {
    "id": "same as request",
    "module": "int",
    "status": "ok | fail | degraded | rolled_back",
    "rc": "int",
    "stdout": "string (head 500)",
    "stderr": "string (head 500)",
    "score_before": "float",
    "score_after": "float",
    "delta_pct": "float",
    "git_restore": "bool",
    "elapsed_sec": "float",
    "notified": ["parliament", "log", "file"]
  }
}
