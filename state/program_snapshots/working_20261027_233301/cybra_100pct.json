{
  "task_id": "cybra_100pct_full",
  "version": "1.0",
  "goal": "Кожен модуль (1-160 + 200-272) має REAL робочу логіку, кожен контролер верифікує, state_100 = 100%",
  "loop_interval_sec": 300,
  "max_attempts_per_item": 3,

  "philosophy": {
    "real_not_stub": "add/list/delete через redis, без '── git ──' dashboard",
    "never_shrink": "нова версія не менша за поточну",
    "controller_per_item": "state/snapshots/ID.json + controllers/ID.ctrl.sh",
    "master_gate": "bin/cybra_state_100.sh = TRUE джерело істини",
    "on_fail": "queue в parliament з detailed_reason",
    "on_100pct": "lock baseline + autopatch на обидва storage"
  },

  "hidl": {
    "dispatcher": "bin/cybra_hidl.py",
    "worker": "bin/cybra_hidl_worker.py",
    "executor": "bin/cybra_hidl_executor.py",
    "notifier": "bin/cybra_hidl_notifier.py",
    "schema": "state/hidl/hidl_schema.json",
    "queues": {
      "work": "cybra:hidl:queue",
      "results": "cybra:hidl:results",
      "failed": "cybra:hidl:invalid"
    }
  },

  "executors": {
    "cybra_ai_executor.sh": {
      "path": "modules/module_19_contract_tui_menu/bin/cybra_ai_executor.sh",
      "roles": ["generate_module"],
      "actions": ["gen <n> <name> <cat>", "full", "scan", "apply", "list", "log"],
      "via": "HIDL action=write_module → parliament_queue",
      "returns": "JSON {status,module,main,ctrl}"
    },
    "cybra_hidl_executor.py": {
      "path": "bin/cybra_hidl_executor.py",
      "roles": ["execute_task", "verify", "rollback"],
      "via": "HIDL queue",
      "returns": "JSON {status,rc,score_before,score_after,delta_pct,git_restore}"
    },
    "cybra_evo_controller.py": {
      "path": "bin/cybra_evo_controller.py",
      "roles": ["score", "baseline", "rollback", "upgrade_weak"],
      "mode": "score-only (НЕ перезаписує код)",
      "via": "PM2 loop 600s"
    },
    "cybra_menu_autorobot.py": {
      "path": "bin/cybra_menu_autorobot.py",
      "roles": ["scan_menu", "push_write_module"],
      "via": "PM2 loop 120s",
      "pushed_key": "cybra:menu:pushed:<n>"
    }
  },

  "controllers": {
    "per_item": {
      "snapshot": "state/snapshots/{id}.json",
      "ctrl": "controllers/{id}.ctrl.sh",
      "fields": ["id", "kind", "ok", "detail", "ts", "target"],
      "kinds": ["module", "pm2", "dart", "api"]
    },
    "master": {
      "file": "state/snapshots/_master.json",
      "fields": ["ts", "total", "passed", "pct", "by_kind", "items"],
      "gate": "bin/cybra_state_100.sh (exit 0 = 100%)",
      "rebuild_cmd": "bash bin/cybra_autobuild_all.sh --state-only"
    }
  },

  "work": {
    "generation": "bin/cybra_ai_100pct_gen.py → state/ai_tasks/mapping.json",
    "runner": "bin/cybra_ai_100pct_runner.py",
    "loop": "1. read mapping → 2. для не-ok items → push hidl → 3. wait → 4. rebuild state_100 → 5. якщо 100% → lock+autopatch → exit",
    "lock_file": "state/ai_tasks/cybra_100pct.lock",
    "state_file": "state/ai_tasks/cybra_100pct_state.json"
  },

  "verification": {
    "threshold_pct": 100,
    "checks": {
      "module": "bash -n + list rc=0 + не dashboard + не '════ taxi'",
      "pm2": "status=online",
      "dart": "has class/import",
      "api": "GET/POST <500 або timeout=skipped"
    }
  },

  "escalation": {
    "on_repeated_fail": "queue в cybra:parliament:failed з attempts=N",
    "notify_via": "bin/cybra_notify.sh",
    "on_100pct": "PM2 restart cybra-autopatch → backup"
  }
}
